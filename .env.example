OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHROMA_PERSIST_DIRECTORY=backend/.chroma
CHROMA_COLLECTION_NAME=books

BOOK_DATA_PATH=backend/data/book_summaries.json
FILTER_CONFIG_PATH=backend/data/filter_config.json

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
TOP_K_RESULTS=5
MAX_QUESTION_LENGTH=200
MAX_HISTORY_MESSAGES=20

LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
LOG_FILE_PATH=backend/logs/app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
LOG_PRIVACY_MODE=redact

# Pricing values are USD per 1,000,000 tokens.
MODEL_PRICING={"gpt-4o-mini":{"input":0.15,"output":0.60},"text-embedding-3-small":{"embedding":0.02}}
